# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

[*]
indent_style = tab
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.java]
indent_style = space

[*.md]
indent_style = space

[*.{yml,yaml}]
indent_style = space

[*.rs]
indent_style = space
indent_size = 4

[*.py]
indent_style = space
indent_size = 4
