{
	"name": "@doglog/root",
	"version": "1.0.0",
	"private": true,
	"workspaces": [
		"lib",
		"studio",
		"web"
	],
	"type": "module",
	"scripts": {
		"format": "oxfmt --check",
		"format:write": "oxfmt",
		"knip": "knip",
		"openspec:check": "pnpm --dir studio exec openspec validate --specs --strict --no-interactive"
	},
	"devDependencies": {
		"@astrojs/compiler-rs": "0.5.3",
		"@fission-ai/openspec": "2.0.0",
		"knip": "6.45.1",
		"oxfmt": "0.78.0"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "26.x",
			"onFail": "warn"
		}
	},
	"packageManager": "pnpm@12.21.0"
}
