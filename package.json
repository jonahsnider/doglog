{
	"name": "@doglog/root",
	"version": "1.0.0",
	"private": true,
	"workspaces": [
		"lib",
		"web"
	],
	"type": "module",
	"scripts": {
		"format": "oxfmt --check",
		"format:write": "oxfmt"
	},
	"devDependencies": {
		"@astrojs/compiler-rs": "0.5.2",
		"oxfmt": "0.75.0"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "24.x",
			"onFail": "warn"
		}
	},
	"packageManager": "pnpm@12.16.1"
}
