{
	"name": "@doglog/root",
	"version": "1.0.0",
	"private": true,
	"workspaces": [
		"lib",
		"studio",
		"web"
	],
	"type": "module",
	"scripts": {
		"format": "oxfmt --check",
		"format:write": "oxfmt",
		"knip": "knip"
	},
	"devDependencies": {
		"@astrojs/compiler-rs": "0.5.3",
		"knip": "6.46.0",
		"oxfmt": "0.79.0"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "26.x",
			"onFail": "warn"
		}
	},
	"packageManager": "pnpm@12.21.0"
}
