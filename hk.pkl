amends "package://github.com/jdx/hk/releases/download/v2.12.0/hk@2.12.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.12.0/hk@2.12.0#/Builtins.pkl"

// Studio checks that CI runs, on the whole project so cross-file errors are caught unless noted
local studio = new Mapping<String, Step> {
  ["studio:check"] {
    dir = "studio"
    glob = "**/*"
    check = "pnpm check"
  }
  ["studio:test"] {
    dir = "studio"
    glob = "src/**/*"
    check = "pnpm test"
  }
  ["studio:react-doctor"] {
    dir = "studio"
    glob = "src/**/*"
    // Its rules are per-file, so only staged files are scanned to keep commits fast. CI runs the full scan
    check = "pnpm exec react-doctor --no-telemetry --staged"
  }
  ["studio:openspec"] {
    dir = "studio"
    glob = "openspec/**/*"
    check = "pnpm openspec:check"
  }
  // Runs from the root since Knip also reads CI workflows and the workspace config
  ["knip"] {
    glob = List("studio/**/*", ".github/workflows/*", "knip.config.ts", "package.json", "pnpm-workspace.yaml")
    check = "pnpm knip"
  }
  ["format"] {
    glob = "**/*"
    check = "pnpm format"
  }
}

hooks {
  ["pre-commit"] {
    // Only check, never fix, so there are no unstaged changes to stash and restore
    fix = false
    stash = "none"
    steps = studio
  }
  ["commit-msg"] {
    steps {
      ["check-conventional-commit"] = (Builtins.check_conventional_commit) {
        allowed_scopes = List("logger", "docs", "studio", "deps")
      }
    }
  }
}
