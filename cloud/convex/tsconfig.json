{
	"compilerOptions": {
		"lib": ["ESNext", "DOM"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"customConditions": ["convex-auth-internal-types"],
		"target": "ESNext",
		"strict": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"allowJs": true,
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"types": ["vite-plus/client"]
	},
	"include": ["./**/*"],
	"exclude": ["./_generated"]
}
