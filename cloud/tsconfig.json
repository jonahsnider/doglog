{
	// Studio's settings, since routes import Studio's code
	"extends": "../studio/tsconfig.app.json",
	"compilerOptions": {
		"incremental": true,
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
		"types": ["vite/client"],
		"paths": {
			"@/*": ["../studio/src/*"],
			"void/routes": ["./.void/routes.d.ts"]
		}
	},
	// Include generated declarations without requiring Void's config when Studio imports shared Cloud code.
	"include": ["routes", ".void/*.d.ts"]
}
