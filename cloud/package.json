{
	"name": "@doglog/cloud",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "vp build",
		"check": "void prepare && vp check && tsc",
		"check:convex": "tsc -p convex",
		"deploy": "void deploy --platform cloudflare",
		"dev": "vp dev",
		"dev:local": "node scripts/dev-local.ts",
		"test:convex": "vp test run --config vitest.config.ts"
	},
	"dependencies": {
		"@convex-dev/auth": "2.1.0",
		"convex": "1.51.0"
	},
	"devDependencies": {
		"@doglog/studio": "workspace:*",
		"convex-test": "0.0.75",
		"typescript": "7.1.0-dev.20261125.1",
		"vite": "catalog:",
		"vite-plugin-svgr": "5.2.0",
		"vite-plus": "catalog:",
		"void": "1.12.0"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "26.x",
			"onFail": "warn"
		}
	}
}
