{
	"name": "@doglog/studio",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		"./link-previews/*": "./src/link-previews/*"
	},
	"scripts": {
		"agent:schema": "node scripts/agent-schema.ts",
		"analyze": "rm -rf node_modules/.rolldown && VITE_DEVTOOLS_ROLLDOWN=true vp build && vite-devtools",
		"astryx": "astryx",
		"bench": "vp test bench",
		"build": "vp build",
		"check": "vp check && tsc -b && node scripts/agent-schema.ts --check",
		"check:dev": "pnpm check && react-doctor --no-telemetry --scope files --include-untracked",
		"check:fix": "vp check --fix",
		"deploy": "wrangler deploy",
		"desktop:install": "VITE_DOGLOG_LOCAL_PREVIEW=1 tauri build --bundles app && rm -rf \"/Applications/DogLog Studio.app\" && ditto \"src-tauri/target/release/bundle/macos/DogLog Studio.app\" \"/Applications/DogLog Studio.app\"",
		"dev": "portless run --force",
		"dev:app": "vp dev",
		"openspec:check": "openspec validate --specs --strict --no-interactive",
		"preview": "vp preview",
		"react-doctor": "react-doctor --no-telemetry --verbose",
		"tauri": "tauri",
		"test": "vp test run"
	},
