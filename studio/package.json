{
	"name": "@doglog/studio",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "vp build",
		"check": "vp check && tsc -b",
		"check:dev": "pnpm check && react-doctor --no-telemetry --scope files --include-untracked",
		"check:fix": "vp check --fix",
		"deploy": "wrangler deploy",
		"desktop:install": "tauri build --bundles app && rm -rf \"/Applications/DogLog Studio.app\" && ditto \"src-tauri/target/release/bundle/macos/DogLog Studio.app\" \"/Applications/DogLog Studio.app\"",
		"dev": "portless",
		"dev:app": "vp dev",
		"openspec:check": "openspec validate --specs --strict --no-interactive",
		"react-doctor": "react-doctor --no-telemetry --verbose",
		"preview": "vp preview",
		"tauri": "tauri",
		"test": "vp test run"
	},
	"dependencies": {
		"@base-ui/react": "1.9.0",
		"@daypicker/react": "10.0.2",
		"@dnd-kit/dom": "0.5.3",
		"@dnd-kit/react": "0.5.3",
		"@fontsource-variable/ibm-plex-sans": "5.3.0",
		"@fontsource-variable/source-sans-3": "5.3.1",
		"@fontsource/ibm-plex-mono": "5.3.0",
		"@material/material-color-utilities": "0.4.0",
		"@ntcore-ts/client": "1.1.1",
		"@sindresorhus/fnv1a": "3.1.0",
		"@tanstack/react-hotkeys": "0.26.0",
		"@tanstack/react-router": "1.170.46",
		"@tanstack/react-store": "0.11.2",
		"@tanstack/react-virtual": "3.14.26",
		"@tanstack/store": "0.11.2",
		"@tauri-apps/api": "2.12.4",
		"@tauri-apps/plugin-dialog": "2.8.4",
		"@tauri-apps/plugin-fs": "2.7.1",
		"@tauri-apps/plugin-opener": "2.7.3",
		"@tauri-apps/plugin-process": "2.4.0",
		"@tauri-apps/plugin-updater": "2.14.1",
		"@ui-sdk/core": "0.1.0-beta.5",
		"@ui-sdk/react": "0.1.0-beta.5",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"convert": "8.1.0",
		"fuzzysort": "4.0.2",
		"idb-keyval": "6.3.0",
		"loro-crdt": "1.18.0",
		"lucide-react": "1.73.0",
		"motion": "14.14.0",
		"nanoid": "6.0.2",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"react-resizable-panels": "4.24.0",
		"shiki": "4.6.0",
		"tailwind-merge": "3.7.0",
		"torph": "0.1.4",
		"usehooks-ts": "3.1.1",
		"wpilib-struct": "1.0.2",
		"wpilog-parser": "4.2.0",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@fission-ai/openspec": "2.0.0",
		"@tailwindcss/vite": "4.3.5",
		"@tanstack/router-plugin": "1.169.0",
		"@tauri-apps/cli": "2.12.4",
		"@tsconfig/strictest": "2.0.9",
		"@types/node": "26.6.6",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vite-pwa/assets-generator": "2.0.0",
		"@vitejs/plugin-react": "6.3.0",
		"portless": "0.17.0",
		"react-doctor": "0.9.23",
		"tailwindcss": "4.3.5",
		"typescript": "7.1.0-dev.20261116.1",
		"vite": "catalog:",
		"vite-plugin-pwa": "2.0.0",
		"vite-plus": "catalog:",
		"wrangler": "4.163.0"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "26.x",
			"onFail": "warn"
		}
	},
	"portless": {
		"name": "studio.doglog.dev",
		"script": "dev:app"
	}
}
