<?xml version="1.0" encoding="utf-8"?>
<!-- Add the `doglog` command to PATH -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="DogLogCliPath" Guid="*">
        <Environment Id="DogLogCliPathEnv" Name="PATH" Value="[INSTALLDIR]bin" Part="last" Action="set" System="yes" Permanent="no" />
        <RegistryValue Root="HKLM" Key="Software\DogLog\DogLog Studio" Name="CliPath" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Fragment>
</Wix>
