{
	"$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
	"productName": "DogLog Studio",
	"version": "0.0.0",
	"identifier": "dev.doglog.studio",
	"build": {
		"frontendDist": "../dist",
		"devUrl": "http://localhost:5173",
		"beforeDevCommand": "pnpm dev:app",
		"beforeBuildCommand": "pnpm build",
		"removeUnusedCommands": true
	},
	"app": {
		"withGlobalTauri": true,
		"windows": [
			{
				"title": "DogLog Studio",
				"titleBarStyle": "Overlay",
				"hiddenTitle": true,
				"trafficLightPosition": { "x": 19, "y": 26 },
				"dragDropEnabled": false,
				"width": 1280,
				"height": 800,
				"resizable": true,
				"fullscreen": false,
				"visible": false
			}
		],
		"security": {
			"csp": null,
			"assetProtocol": {
				"enable": true,
				"scope": []
			}
		}
	},
	"bundle": {
		"active": true,
		"publisher": "Jonah Snider",
		"copyright": "Copyright © 2026 Jonah Snider",
		"category": "DeveloperTool",
		"shortDescription": "Review FRC robot logs and debug robots live",
		"homepage": "https://studio.doglog.dev",
		"targets": ["app", "dmg", "nsis", "appimage", "deb"],
		"icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
		"fileAssociations": [
			{
				"ext": ["wpilog"],
				"name": "WPILOG",
				"description": "WPILOG robot log",
				"role": "Viewer",
				"mimeType": "application/x-wpilog",
				"exportedType": {
					"identifier": "dev.doglog.studio.wpilog",
					"conformsTo": ["public.data"]
				}
			},
			{
				"ext": ["wpilogxz"],
				"name": "WPILOGXZ",
				"description": "Compressed WPILOG robot log",
				"role": "Viewer",
				"mimeType": "application/x-wpilogxz",
				"exportedType": {
					"identifier": "dev.doglog.studio.wpilogxz",
					"conformsTo": ["public.data"]
				}
			}
		],
		"android": {
			"debugApplicationIdSuffix": ".debug"
		},
		"macOS": {
			"minimumSystemVersion": "15.0",
			"files": {
				"Resources/AppIcon.icon": "../assets/mac.icon",
				"Resources/bin/doglog": "cli/macos/doglog"
			}
		},
		"linux": {
			"deb": {
				"files": {
					"/usr/bin/doglog": "cli/linux/doglog"
				}
			}
		}
	},
	"plugins": {
		"macos-fps": { "enabled": true },
		"deep-link": { "desktop": { "schemes": ["doglog"] } },
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAzM0I1RkVGNEM3QTRBRkUKUldUK1NucE03MTg3QS9mWjZZRGdaZWVHQWYxb0hnRzNYOXl0OWg1QW1KWGV3QWFEczhYZHIxcGgK",
			"endpoints": ["https://updates.doglog.dev/studio/latest.json"]
		}
	}
}
