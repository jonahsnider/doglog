{
	"$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
	"productName": "DogLog Studio",
	"version": "0.0.0",
	"identifier": "dev.doglog.studio",
	"build": {
		"frontendDist": "../dist",
		"devUrl": "http://localhost:5173",
		"beforeDevCommand": "pnpm dev:app",
		"beforeBuildCommand": "pnpm build"
	},
	"app": {
		"windows": [
			{
				"title": "DogLog Studio",
				"width": 1280,
				"height": 800,
				"resizable": true,
				"fullscreen": false
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
		"fileAssociations": [
			{
				"ext": ["wpilog"],
				"name": "WPILOG",
				"description": "WPILOG robot log",
				"role": "Viewer",
				"mimeType": "application/x-wpilog",
				"exportedType": {
					"identifier": "dev.doglog.studio.wpilog",
					"conformsTo": ["public.data"]
				}
			}
		],
		"android": {
			"debugApplicationIdSuffix": ".debug"
		},
		"macOS": {
			"files": {
				"Resources/AppIcon.icon": "../assets/mac.icon"
			}
		}
	}
}
