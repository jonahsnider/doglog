{
	"main": "./worker/index.ts",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		// Unmatched paths go to the Worker so missing `/assets/*` return 404 instead of `index.html` with immutable caching
		"not_found_handling": "none",
		// Dashboard links always run the Worker for Open Graph tags; existing static assets bypass it
		"run_worker_first": ["/shared/*"],
	},
	"compatibility_date": "2026-11-15",
	"name": "doglog-studio",
	"upload_source_maps": true,
	// Request telemetry must not log dashboard links.
	"observability": {
		"enabled": false,
		"issues": { "enabled": false },
		"logs": { "enabled": false },
		"traces": { "enabled": false },
	},
	"route": {
		"custom_domain": true,
		"pattern": "doglog.studio",
	},
	"workers_dev": false,
	"$schema": "./node_modules/wrangler/config-schema.json",
}
