{
	"main": "./worker/index.ts",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		// Only dashboard links need the Worker, every other request is a static asset
		"run_worker_first": ["/import/*"],
	},
	"compatibility_date": "2026-11-15",
	"name": "doglog-studio",
	"upload_source_maps": true,
	// Request telemetry can capture dashboard snapshots carried in link URLs.
	"observability": {
		"enabled": false,
		"issues": { "enabled": false },
		"logs": { "enabled": false },
		"traces": { "enabled": false },
	},
	"route": {
		"custom_domain": true,
		"pattern": "doglog.studio",
	},
	"workers_dev": false,
	"$schema": "./node_modules/wrangler/config-schema.json",
}
