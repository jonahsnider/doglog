{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"tabWidth": 2,
	"useTabs": true,
	"singleQuote": true,
	"printWidth": 120,
	"astro": true,
	"ignorePatterns": [
		"build/",
		"cloud/convex/_generated/",
		"infer-out/",
		"lib/",
		"studio/",
		"test-project/",
		"web/.astro/",
		".claude/",
		"pnpm-lock.yaml",
		"CHANGELOG.md",
		"/vendordep.json",
		"/web/public/vendordep.json",
		"web/src/content/docs/reference/changelog.md",
		"void.lock.json"
	]
}
